<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 为什么需要：工具箱的「打开报告目录」用 NSWorkspace.activateFileViewerSelecting，
	     它经 appleeventsd 控制 Finder。Hardened Runtime 下 tccd 要求访问方带此 entitlement，
	     缺失时被拒（2026-09-21 旧身份 com.xunfeng.identityv.monitor 的 tccd
	     证据显示 requires entitlement），表现为在 Finder 中显示无效。
	     适用条件：只为这条 reveal 路径声明；工具箱不采集麦克风/摄像头，故不给其它权限。
	     新身份仍须在实际 Finder 打开报告路径复验；见 docs/firstPartyIdentity.md。 -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
