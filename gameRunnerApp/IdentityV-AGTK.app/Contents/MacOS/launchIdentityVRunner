launch_game_once() {
  local input_trace=0
  local login_readiness=""
  local -a inserted_libraries hud_environment
  if [[ -L "$INPUT_TRACE_ONCE_MARKER" ]]; then
    print -r -- "ignored symlinked developer input trace marker" >>"$LOG_FILE"
  elif [[ -f "$INPUT_TRACE_ONCE_MARKER" ]]; then
    /bin/rm -f -- "$INPUT_TRACE_ONCE_MARKER"
    input_trace=1
  fi
  if (( input_trace )); then
    export WINEDEBUG="+timestamp,+key,+event,+rawinput,+dinput"
    print -r -- "one-shot developer input trace enabled for this game session; trace records key codes, event batching and Windows input API state" >>"$LOG_FILE"
  else
    export WINEDEBUG="-all"
  fi
  inserted_libraries=("$COMMAND_GRAVE_FORWARDER")
  if [[ -n "$AUDIO_INTERPOSER" ]]; then
    inserted_libraries+=("$AUDIO_INTERPOSER")
    print -r -- "enabled CoreAudio interposer stage: $IDENTITYV_AUDIO_INTERPOSER_STAGE" >>"$LOG_FILE"
  fi
  if [[ -x "$IDV_LOGIN_START_HELPER" && ! -L "$IDV_LOGIN_START_HELPER" ]] &&
     [[ "$(/usr/bin/stat -f '%u:%Lp' "$IDV_LOGIN_START_HELPER" 2>/dev/null || true)" == "0:755" ]]; then
    login_readiness="$(/usr/bin/sudo -n "$IDV_LOGIN_START_HELPER" --status 2>/dev/null | /usr/bin/tail -n 1 || true)"
  fi
  if [[ "$login_readiness" == "IDV_LOGIN_READINESS=ready" ]]; then
    inserted_libraries+=("$LOGIN_DNS_COMPAT")
    print -r -- "enabled IDV Login Wine-local DNS compatibility layer after exact readiness gate" >>"$LOG_FILE"
  else
    print -r -- "IDV Login DNS compatibility layer inactive: proxy is not exactly ready" >>"$LOG_FILE"
  fi
  export DYLD_INSERT_LIBRARIES="${(j.:.)inserted_libraries}"
  if [[ "$IDENTITYV_USE_VIRTUAL_DESKTOP" == "1" ]]; then
    # Wine explorer is a bootstrap chain, not the final dwrg.exe child. Keep
    # this optional path HUD-free instead of leaking diagnostics into it.
    if [[ "$METAL_HUD_ENABLED" == "1" ]]; then
      print -r -- "Metal HUD requested but disabled for virtual desktop bootstrap" >>"$LOG_FILE"
    else
      print -r -- "Metal HUD disabled for virtual desktop bootstrap" >>"$LOG_FILE"
    fi
    print -r -- "launch mode: virtual desktop ${IDENTITYV_DESKTOP_NAME},${IDENTITYV_DESKTOP_SIZE}" >>"$LOG_FILE"
    "$WINE_BIN" explorer "/desktop=${IDENTITYV_DESKTOP_NAME},${IDENTITYV_DESKTOP_SIZE}" "C:\\Games\\${WINDOWS_GAME_ROOT}\\dwrg.exe" "${GAME_LAUNCH_ARGUMENTS[@]}" >>"$LOG_FILE" 2>&1 &
  else
    if [[ "$METAL_HUD_ENABLED" == "1" ]]; then
      # Apple exposes no reliable "expanded" environment switch. Keep a
      # fixed, complete first-view layout rather than pretending one exists.
      hud_environment=(
        MTL_HUD_ENABLED=1
        MTL_HUD_DISABLE_MENU_BAR=1
        MTL_HUD_LOG_ENABLED=0
        MTL_HUD_SHOW_METRICS_RANGE=1
        MTL_HUD_SCALE=0.16
        MTL_HUD_ALIGNMENT=topright
        MTL_HUD_ELEMENTS=device,layersize,memory,fps,frameinterval,gputime,presentdelay,frameintervalgraph,fpsgraph
      )
      print -r -- "Metal HUD enabled for final dwrg.exe child only" >>"$LOG_FILE"
    else
      hud_environment=()
      print -r -- "Metal HUD disabled for final dwrg.exe child" >>"$LOG_FILE"
    fi
    print -r -- "launch mode: direct" >>"$LOG_FILE"
    # Do not put /usr/bin/env between this shell and Wine: SIP removes
    # DYLD_FALLBACK_LIBRARY_PATH when launching that system executable, which
    # prevents Wine from resolving its bundled FreeType.  The shell child
    # retains the runner's library path, adds HUD vars only for direct dwrg,
    # then execs Wine so LAUNCHED_WINE_PID is still Wine's PID.
    (
      if (( ${#hud_environment[@]} )); then
        export "${hud_environment[@]}"
      fi
      exec "$WINE_BIN" "C:\\Games\\${WINDOWS_GAME_ROOT}\\dwrg.exe" "${GAME_LAUNCH_ARGUMENTS[@]}"
    ) >>"$LOG_FILE" 2>&1 &
  fi
  LAUNCHED_WINE_PID=$!
  # `print -r` deliberately preserves backslashes, so a quoted `\n` payload
  # becomes one malformed line.  Emit real lines: the product manager and stop
  # path treat this file as the authority for a runner-owned session.
  (umask 077; /usr/bin/printf 'schema=1\nproduct=%s\nrunner_pid=%s\nwine_pid=%s\nwindows_root=%s\n' \
    "$PRODUCT" "$$" "$LAUNCHED_WINE_PID" "$WINDOWS_GAME_ROOT" >| "$RUN_SESSION_FILE")
}

stop_prefix_processes() {
  # This runner gets PREFIX and WINESERVER_BIN only after both were resolved
  # against the selected volume/runtime.  Keep the guard here as well: a
  # cleanup path must never turn a malformed environment into a request to an
  # unrelated Wine prefix (for example IDV Login or the other service).
  if [[ -z "${PREFIX:-}" || "${WINEPREFIX:-}" != "$PREFIX" || ! -x "${WINESERVER_BIN:-}" ]]; then
    print -r -- "skip Wine prefix cleanup: verified runner environment is unavailable" >>"$LOG_FILE"
    return 1
  fi

  clear_metal_hud_environment
  print -r -- "requesting Wine prefix cleanup for $PREFIX" >>"$LOG_FILE"
  "$WINESERVER_BIN" -k >>"$LOG_FILE" 2>&1 || true

  # -k asks the wineserver for this exact WINEPREFIX to close every client;
  # -w confirms that its own services (explorer/rpcss/winedevice, etc.) have
  # actually drained.  Bound that confirmation so an unhealthy wineserver can
  # never make a launcher restart wait forever.
  "$WINESERVER_BIN" -w >>"$LOG_FILE" 2>&1 &
  local wait_pid=$!
  local attempt
  for attempt in {1..30}; do
    /bin/kill -0 "$wait_pid" >/dev/null 2>&1 || break
    sleep 0.1
  done
  if /bin/kill -0 "$wait_pid" >/dev/null 2>&1; then
    print -r -- "Wine prefix cleanup confirmation timed out after 3s" >>"$LOG_FILE"
    /bin/kill -TERM "$wait_pid" >/dev/null 2>&1 || true
    local terminate_attempt
    for terminate_attempt in {1..10}; do
      /bin/kill -0 "$wait_pid" >/dev/null 2>&1 || break
      sleep 0.1
    done
    /bin/kill -KILL "$wait_pid" >/dev/null 2>&1 || true
  fi
  wait "$wait_pid" >/dev/null 2>&1 || true
}

reset_prefix_if_display_changed() {
  local current_signature previous_signature
  current_signature="$(/usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
  [[ -n "$current_signature" ]] || return 0
  previous_signature="$(/bin/cat "$DISPLAY_SIGNATURE_FILE" 2>/dev/null || true)"
  if [[ -n "$previous_signature" && "$previous_signature" != "$current_signature" ]]; then
    print -r -- "display mode changed; resetting Wine prefix so Retina state can reinitialize" >>"$LOG_FILE"
    stop_prefix_processes
  fi
  print -r -- "$current_signature" >| "$DISPLAY_SIGNATURE_FILE"
}

ensure_private_standard_folders() {
  local mac_home windows_user_dir folder_name mac_folder_name wine_folder mac_folder entry resolved_target i
  local -a protected_windows_folders protected_macos_folders
  mac_home="$(/bin/realpath "$HOME" 2>/dev/null || true)"
  [[ -n "$mac_home" ]] || return 0
  protected_windows_folders=(Desktop Documents Downloads Pictures Music Videos)
  # CrossOver exposes the macOS Movies folder as the Windows Videos folder.
  protected_macos_folders=(Desktop Documents Downloads Pictures Music Movies)

  # A CodeWeavers prefix commonly uses a Windows account such as "crossover"
  # instead of the current macOS short name. Inspect every Windows profile and
  # keep only its private copies of standard folders.  We deliberately remove
  # a link only when it resolves into the signed-in user's matching macOS
  # folder, never merely because it is a link.
  for windows_user_dir in "$PREFIX"/drive_c/users/*(/N); do
    for ((i = 1; i <= ${#protected_windows_folders}; i++)); do
      folder_name="${protected_windows_folders[i]}"
      mac_folder_name="${protected_macos_folders[i]}"
      wine_folder="$windows_user_dir/$folder_name"
      # Resolve the macOS standard folder itself: users may relocate one via a
      # symlink, for example moving Downloads to another volume.
      mac_folder="$(/bin/realpath "$mac_home/$mac_folder_name" 2>/dev/null || true)"
      [[ -n "$mac_folder" ]] || continue

      if [[ -L "$wine_folder" ]]; then
        resolved_target="$(/bin/realpath "$wine_folder" 2>/dev/null || true)"
        if [[ "$resolved_target" == "$mac_folder" || "$resolved_target" == "$mac_folder"/* ]]; then
          /bin/rm "$wine_folder" >>"$LOG_FILE" 2>&1 || continue
          /bin/mkdir -p "$wine_folder" >>"$LOG_FILE" 2>&1 || true
          print -r -- "isolated Wine $folder_name for Windows user ${windows_user_dir:t}" >>"$LOG_FILE"
        fi
      fi

      [[ -d "$wine_folder" && ! -L "$wine_folder" ]] || continue
      while IFS= read -r -d '' entry; do
        resolved_target="$(/bin/realpath "$entry" 2>/dev/null || true)"
        if [[ "$resolved_target" == "$mac_folder" || "$resolved_target" == "$mac_folder"/* ]]; then
          /bin/rm "$entry" >>"$LOG_FILE" 2>&1 || continue
          print -r -- "removed macOS $folder_name bridge ${entry:t} for Windows user ${windows_user_dir:t}" >>"$LOG_FILE"
        fi
      done < <(/usr/bin/find -P "$wine_folder" -type l -print0 2>/dev/null)
    done
  done
}

