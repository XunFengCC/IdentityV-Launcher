configure_catalog_cjk_font() {
  local family filename expected target source temporary actual
  actual=""
  family="$(plist_raw "$CATALOG_FILE" "engines.$SELECTED_ENGINE_ID.fontConfiguration.cjkFamily" || true)"
  filename="$(plist_raw "$CATALOG_FILE" "engines.$SELECTED_ENGINE_ID.fontConfiguration.cjkFilename" || true)"
  expected="$(plist_raw "$CATALOG_FILE" "engines.$SELECTED_ENGINE_ID.fontConfiguration.cjkSha256" || true)"
  [[ -n "$family$filename$expected" ]] || return 0
  [[ -n "$family" && ${#family} -lt 32 ]] || return 1
  case "$family" in *'"'*|*'\'*|*$'\n'*|*$'\r'*) return 1 ;; esac
  validate_relative_path "$filename" || return 1
  [[ "$filename" != */* && ${#expected} -eq 64 && "$expected" != *[!0-9A-Fa-f]* ]] || return 1
  target="$PREFIX/drive_c/windows/Fonts/$filename"
  [[ ! -L "$target" ]] || return 1
  # A newly installed App can ship an OFL font with its exact catalog hash.
  # Prefix mutation happens only after the game collision guard and wineserver
  # stop above; keep an already verified local maintainer font untouched.
  if [[ -f "$target" ]]; then
    actual="$(/usr/bin/shasum -a 256 "$target" | /usr/bin/awk '{print $1}')"
  fi
  if [[ "${actual:l}" != "${expected:l}" ]]; then
    source="$APP_CONTENTS/Resources/Fonts/$filename"
    [[ -f "$source" && ! -L "$source" ]] || return 1
    actual="$(/usr/bin/shasum -a 256 "$source" | /usr/bin/awk '{print $1}')"
    [[ "${actual:l}" == "${expected:l}" ]] || return 1
    temporary="$(/usr/bin/mktemp "$target.tmp.XXXXXX")" || return 1
    if ! /bin/cp "$source" "$temporary" || ! /bin/chmod 644 "$temporary" || ! /bin/mv -f "$temporary" "$target"; then
      /bin/rm -f "$temporary"
      return 1
    fi
    print -r -- "installed verified catalog font into prefix: $filename" >>"$LOG_FILE"
  fi
  [[ -f "$target" && ! -L "$target" ]] || return 1
  actual="$(/usr/bin/shasum -a 256 "$target" | /usr/bin/awk '{print $1}')"
  [[ "${actual:l}" == "${expected:l}" ]] || return 1
  CJK_UI_FONT_FAMILY="$family"
  CJK_UI_FONT_FILENAME="$filename"
  print -r -- "selected verified catalog CJK/emoji font: $family ($filename)" >>"$LOG_FILE"
}

# The mainland client ships a matching native 64-bit D3DCompiler beside its
# CEF webview.  Wine's builtin compiler rejects one of its terrain shaders,
# but accepting an arbitrary DLL here would turn a launcher workaround into a
# game-tree injection point.  Bind the one permitted candidate to the game's
# own patch manifest before placing it in this prefix only.
d3dcompiler_file_is_64() {
  local inspected
  inspected="$(/usr/bin/file -b "$1" 2>/dev/null || true)"
  [[ "$inspected" == *"PE32+"* && "$inspected" == *"x86-64"* ]]
}

native_d3dcompiler_manifest_entry() {
  local manifest="$1" source_relative="$2" xml entry size digest hash md5 key_count size_count hash_count md5_count raw_key_count
  [[ -n "$source_relative" && "$source_relative" != *[!A-Za-z0-9._/-]* ]] || return 1
  [[ -f "$manifest" && ! -L "$manifest" ]] || return 1
  raw_key_count="$(LC_ALL=C /usr/bin/grep -o -F -- "\"$source_relative\"" "$manifest" 2>/dev/null | /usr/bin/wc -l | /usr/bin/tr -d '[:space:]')"
  [[ "$raw_key_count" == 1 ]] || return 1
  xml="$(/usr/bin/mktemp /tmp/identityv-engine-patch.XXXXXX)" || return 1
  /bin/chmod 600 "$xml" 2>/dev/null || { /bin/rm -f -- "$xml"; return 1; }
  /usr/bin/plutil -convert xml1 -o "$xml" "$manifest" >/dev/null 2>&1 || { /bin/rm -f -- "$xml"; return 1; }
  entry="/plist/dict/key[text()='$source_relative']/following-sibling::*[1][self::dict]"
  key_count="$(/usr/bin/xmllint --xpath "count(/plist/dict/key[text()='$source_relative'])" "$xml" 2>/dev/null || true)"
  size_count="$(/usr/bin/xmllint --xpath "count($entry/key[text()='size']/following-sibling::*[1][self::integer])" "$xml" 2>/dev/null || true)"
  hash_count="$(/usr/bin/xmllint --xpath "count($entry/key[text()='hash']/following-sibling::*[1][self::string])" "$xml" 2>/dev/null || true)"
  md5_count="$(/usr/bin/xmllint --xpath "count($entry/key[text()='md5']/following-sibling::*[1][self::string])" "$xml" 2>/dev/null || true)"
  size="$(/usr/bin/xmllint --xpath "string($entry/key[text()='size']/following-sibling::*[1][self::integer])" "$xml" 2>/dev/null || true)"
  hash="$(/usr/bin/xmllint --xpath "string($entry/key[text()='hash']/following-sibling::*[1][self::string])" "$xml" 2>/dev/null || true)"
  md5="$(/usr/bin/xmllint --xpath "string($entry/key[text()='md5']/following-sibling::*[1][self::string])" "$xml" 2>/dev/null || true)"
  /bin/rm -f -- "$xml"
  # NetEase calls the 32-hex MD5 value `hash` in current manifests, while
  # older manifests called it `md5`.  Accept exactly one spelling: accepting
  # both (or an untyped lookalike) would make this game-tree boundary
  # ambiguous.  The value is still checked with /sbin/md5 below.
  if [[ "$hash_count" == 1 && "$md5_count" == 0 ]]; then
    digest="$hash"
  elif [[ "$hash_count" == 0 && "$md5_count" == 1 ]]; then
    digest="$md5"
  else
    return 1
  fi
  [[ "$key_count" == 1 && "$size_count" == 1 && "$size" == <-> && "$digest" != *[!0-9A-Fa-f]* && ${#digest} -eq 32 ]] || return 1
  print -r -- "$size ${digest:l}"
}

install_verified_native_d3dcompiler() {
  # Both r1 and self-built Wine need this for terrain shaders. A fresh r1
  # installation must first let the game create its patch manifest; defer only
  # while that file is absent, then apply the same strict verification on the
  # next launch. Existing but invalid manifests never authorize a DLL copy.
  [[ "$PRODUCT" == "mainland" &&
     "$LAUNCH_PROFILE" == "codeweavers-wine-release-dxmt" &&
     ( "$D3DCOMPILER47_POLICY" == "verified-game-native-dynamic-only" ||
       "$D3DCOMPILER47_POLICY" == "verified-game-native-when-manifest-present" ) ]] || return 0
  local candidate source_relative manifest expected actual_size actual_md5 source_count=0
  local source_dir target_parent target temp prefix_real target_parent_real chain_part
  manifest="$GAME_DIR/Documents/engine_patch_check.file"
  if [[ "$D3DCOMPILER47_POLICY" == "verified-game-native-when-manifest-present" &&
        ! -e "$manifest" && ! -L "$manifest" ]]; then
    print -r -- "native D3DCompiler deferred: game patch manifest not yet created; retry on next launch" >>"$LOG_FILE"
    return 0
  fi
  for candidate in "$GAME_DIR"/webviewsupport.cef*/d3dcompiler_47.dll(N); do
    source_dir="${candidate:h}"
    [[ -f "$candidate" && ! -L "$candidate" && -d "$source_dir" && ! -L "$source_dir" ]] || continue
    [[ "${source_dir:t}" == webviewsupport.cef?* && "${source_dir:t}" != *[!A-Za-z0-9._-]* ]] || continue
    source_relative="${candidate#$GAME_DIR/}"
    validate_relative_path "$source_relative" || continue
    [[ -n "$source_relative" && "$source_relative" != *[!A-Za-z0-9._/-]* ]] || continue
    source_count=$((source_count + 1))
    source="$candidate"
  done
  (( source_count == 1 )) || abort_launcher "native D3DCompiler source is missing or ambiguous"
  expected="$(native_d3dcompiler_manifest_entry "$manifest" "$source_relative" || true)"
  [[ "$expected" == <->\ * && "${expected##* }" != *[!0-9a-f]* && ${#expected##* } -eq 32 ]] || abort_launcher "native D3DCompiler manifest entry is unavailable or invalid"
  actual_size="$(/usr/bin/stat -f '%z' "$source" 2>/dev/null || true)"
  actual_md5="$(/sbin/md5 -q "$source" 2>/dev/null || true)"
  [[ "$actual_size" == "${expected%% *}" && "${actual_md5:l}" == "${expected##* }" ]] || abort_launcher "native D3DCompiler integrity check failed"
  d3dcompiler_file_is_64 "$source" || abort_launcher "native D3DCompiler is not a 64-bit PE32+ DLL"

  prefix_real="$(/bin/realpath "$PREFIX" 2>/dev/null || true)"
  [[ -n "$prefix_real" && -d "$prefix_real" ]] || abort_launcher "Wine prefix cannot be canonicalized for native D3DCompiler"
  for chain_part in "$PREFIX/drive_c" "$PREFIX/drive_c/windows" "$PREFIX/drive_c/windows/system32"; do
    [[ -d "$chain_part" && ! -L "$chain_part" ]] || abort_launcher "Wine system32 target directory is unsafe"
  done
  target_parent="$PREFIX/drive_c/windows/system32"
  target_parent_real="$(/bin/realpath "$target_parent" 2>/dev/null || true)"
  [[ "$target_parent_real" == "$prefix_real"/* ]] || abort_launcher "Wine system32 target directory escapes the selected prefix"
  target_parent="$target_parent_real"
  target="$target_parent/d3dcompiler_47.dll"
  if [[ -f "$target" && ! -L "$target" ]] &&
     [[ "$(/usr/bin/stat -f '%z' "$target" 2>/dev/null || true)" == "$actual_size" ]] &&
     [[ "$(/sbin/md5 -q "$target" 2>/dev/null || true)" == "${actual_md5:l}" ]]; then
    print -r -- "native D3DCompiler already current: $source_relative md5=${actual_md5:l}" >>"$LOG_FILE"
    return 0
  fi
  temp="$(/usr/bin/mktemp "$target_parent/.identityv-d3dcompiler.XXXXXX")" || abort_launcher "cannot stage native D3DCompiler"
  /bin/chmod 600 "$temp" || { /bin/rm -f -- "$temp"; abort_launcher "cannot protect native D3DCompiler staging file"; }
  /bin/cp "$source" "$temp" || { /bin/rm -f -- "$temp"; abort_launcher "cannot stage native D3DCompiler"; }
  [[ "$(/usr/bin/stat -f '%z' "$temp" 2>/dev/null || true)" == "$actual_size" ]] &&
    [[ "$(/sbin/md5 -q "$temp" 2>/dev/null || true)" == "${actual_md5:l}" ]] && d3dcompiler_file_is_64 "$temp" || {
      /bin/rm -f -- "$temp"; abort_launcher "native D3DCompiler staging verification failed"; }
  /bin/chmod 644 "$temp" || { /bin/rm -f -- "$temp"; abort_launcher "cannot finalize native D3DCompiler staging file"; }
  /bin/mv -f "$temp" "$target" || { /bin/rm -f -- "$temp"; abort_launcher "cannot install native D3DCompiler"; }
  print -r -- "installed verified native D3DCompiler: $source_relative md5=${actual_md5:l}" >>"$LOG_FILE"
}

export WINEPREFIX="$PREFIX"
# Registry setup and helper Wine calls must never inherit an audio candidate or
# a diagnostic HUD. The only HUD injection is the final dwrg.exe child below.
unset DYLD_INSERT_LIBRARIES
clear_metal_hud_environment
export WINEDEBUG="-all"

if (( PREFLIGHT_ONLY )); then
  print -r -- "Identity V launcher preflight passed: $SELECTED_ENGINE_ID ($LAUNCH_PROFILE), CoreAudio=$IDENTITYV_AUDIO_INTERPOSER_STAGE"
  exit 0
fi

trap 'clear_run_session; cleanup_launcher' EXIT
trap 'handle_launcher_signal INT 130' INT
trap 'handle_launcher_signal TERM 143' TERM
trap 'handle_launcher_signal HUP 129' HUP

existing_game_pid=""
if [[ -f "$RUN_SESSION_FILE" && ! -L "$RUN_SESSION_FILE" ]]; then
  session_product="$(/usr/bin/awk -F= '$1 == "product" { print $2; exit }' "$RUN_SESSION_FILE" 2>/dev/null || true)"
  session_pid="$(/usr/bin/awk -F= '$1 == "wine_pid" { print $2; exit }' "$RUN_SESSION_FILE" 2>/dev/null || true)"
  if [[ "$session_product" == "$PRODUCT" && "$session_pid" == <-> ]]; then
    session_command="$(/bin/ps -p "$session_pid" -o command= 2>/dev/null || true)"
    [[ "$session_command" == *"C:\\Games\\${WINDOWS_GAME_ROOT}\\dwrg.exe"* ]] && existing_game_pid="$session_pid"
  fi
fi
if [[ -z "$existing_game_pid" ]]; then
  # This is a collision guard only, never a cleanup selector.  The escaped
  # trailing backslash keeps IdentityV distinct from IdentityVGlobal.
  existing_game_pid="$(/usr/bin/pgrep -u "$(id -u)" -f "C:\\\\Games\\\\${WINDOWS_GAME_ROOT}\\\\dwrg[.]exe" | /usr/bin/head -n 1 || true)"
fi
if [[ -n "$existing_game_pid" ]]; then
  print -r -- "game already running as pid $existing_game_pid; leave the active Wine session untouched" >>"$LOG_FILE"
  trap - EXIT INT TERM HUP
  exit 0
fi

reset_prefix_if_display_changed

# Wine caches fonts and macdrv settings per session. Remove stale prefix
# helpers before changing either the managed Fonts directory or the registry
# contract, so an existing wineserver cannot retain old aliases or input state.
stop_prefix_processes
recover_mouse_acceleration_state
if [[ -x "$FUNCTION_KEY_CONTROLLER" ]]; then
  "$FUNCTION_KEY_CONTROLLER" --recover --state-file "$FUNCTION_KEY_STATE_FILE" >>"$LOG_FILE" 2>&1 || true
fi
ensure_private_standard_folders
ensure_prefix_fonts || abort_launcher "no verified CJK UI font is available"
configure_catalog_cjk_font || abort_launcher "the selected engine's CJK/emoji font is missing or invalid"

IMM32_DST="$GAME_DIR/imm32.dll"
if [[ -f "$IMM32_SRC" && ! -e "$IMM32_DST" ]]; then
  /bin/cp "$IMM32_SRC" "$IMM32_DST" >>"$LOG_FILE" 2>&1 || true
  /bin/chmod 644 "$IMM32_DST" >>"$LOG_FILE" 2>&1 || true
fi

# These values define the launcher's input/display contract.  Import them in a
# single Wine process and publish a versioned marker only after success; this
# removes ten serial Wine startups from every normal launch while still
# retrying automatically when the contract or selected runtime changes.
refresh_registry_contract || true
# Registry and Wine helper calls above are the last prefix mutations before
# launch.  Install only now, so their initialization cannot replace the DLL.
install_verified_native_d3dcompiler
begin_mouse_acceleration_session

cd "$GAME_DIR" || exit 1
if [[ "$IDENTITYV_FORCE_GAME_MODE" == "1" ]]; then
  set_game_mode_on
else
  print -r -- "skip forced Game Mode; restoring automatic policy for minimal regression test" >>"$LOG_FILE"
  restore_game_mode_auto
fi
exit_code=0
restart_count=0

while true; do
  initialize_stall_watch
  game_log_sig_before="$(/usr/bin/stat -f '%m:%z' "$GAME_DIR/log.txt" 2>/dev/null || print -r -- absent)"
  seen_log_activity=0
  print -r -- "launch wine at $(/bin/date '+%Y-%m-%d %H:%M:%S %Z')" >>"$LOG_FILE"
  launch_game_once
  wine_pid="$LAUNCHED_WINE_PID"
  if [[ -z "$wine_pid" ]]; then
    print -r -- "failed to capture launched Wine PID" >>"$LOG_FILE"
    exit_code=1
    break
  fi
  begin_function_key_watch "$wine_pid"
  # One bounded activation per new game PID, including restart launches. This
  # runs off the monitoring path and never keeps raising a running session.
  if [[ "$IDENTITYV_USE_VIRTUAL_DESKTOP" != "1" && -x "$APP_CONTENTS/Resources/IdentityVGameActivator" ]]; then
    /usr/bin/env -u DYLD_INSERT_LIBRARIES -u DYLD_FALLBACK_LIBRARY_PATH \
      "$APP_CONTENTS/Resources/IdentityVGameActivator" --pid "$wine_pid" \
      --expected-executable "$WINE_BIN" --timeout 90 >>"$LOG_FILE" 2>&1 &
  fi
  update_restart=0

  while /bin/kill -0 "$wine_pid" >/dev/null 2>&1; do
    append_low_frequency_sample "$wine_pid"
    update_stall_watch "$wine_pid"
    game_log_sig_now="$(/usr/bin/stat -f '%m:%z' "$GAME_DIR/log.txt" 2>/dev/null || print -r -- absent)"
    if [[ "$game_log_sig_now" != "$game_log_sig_before" ]]; then
      seen_log_activity=1
    fi
    if [[ "$IDENTITYV_AUTO_RESTART_ON_UPDATE" == "1" ]] && (( restart_count < IDENTITYV_RESTART_LIMIT )) && (( seen_log_activity == 1 )) && restart_marker_seen; then
      print -r -- "update restart marker detected; restarting game once current Wine process is stopped" >>"$LOG_FILE"
      stop_prefix_processes
      /bin/kill "$wine_pid" >/dev/null 2>&1 || true
      sleep 1
      /bin/kill -9 "$wine_pid" >/dev/null 2>&1 || true
      update_restart=1
      break
    fi
    sleep 2
  done

  wait "$wine_pid"
  exit_code=$?
  if [[ "$IDENTITYV_AUTO_RESTART_ON_UPDATE" == "1" ]] && (( restart_count < IDENTITYV_RESTART_LIMIT )) && { (( update_restart == 1 )) || { (( seen_log_activity == 1 )) && restart_marker_seen; }; }; then
    restart_count=$((restart_count + 1))
    print -r -- "auto restart ${restart_count}/${IDENTITYV_RESTART_LIMIT} after game update marker, previous exit=$exit_code" >>"$LOG_FILE"
    stop_prefix_processes
    sleep 3
    continue
  fi

  break
done

print -r -- "wine exited $exit_code at $(/bin/date '+%Y-%m-%d %H:%M:%S %Z')" >>"$LOG_FILE"
exit "$exit_code"
